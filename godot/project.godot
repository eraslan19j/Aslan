; Istanbul Streets — Godot 4.7.2 Faz 0.5 Kanıt Prototipi
;
; AMAÇ: Tahminleri ölçüme çevirmek. Bu bir oyun değil, bir ÖLÇÜM ARACI.
; Kabul kriterleri: K1–K8 (bkz. docs/memory/ROADMAP_V2_GODOT.md)
;
; Sürüm tek kaynağı: ../version.json (sync-version.mjs tarafından yönetilir)

config_version=5

[application]

config/name="Istanbul Streets Prototype"
config/description="Faz 0.5 kanıt prototipi — performans ve görsel kalite ölçümü"
config/version="0.10.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[audio]

driver/enable_input=false
driver/output_latency=15

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1

[display]

window/size/viewport_width=2340
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=443
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/default_gravity=9.81

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.53, 0.6, 0.68, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/split_1=0.35
lights_and_shadows/directional_shadow/blend_splits=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
depth_prepass_alpha=true
driver/depth_prepass/enable=true
