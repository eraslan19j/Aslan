{
  "name": "istanbul-streets",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Istanbul Streets — 3rd-person open-world action/driving game set in Istanbul (Vite + TypeScript + Three.js + Rapier3D + Capacitor 8).",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke": "node scripts/smoke.mjs",
    "soak": "node scripts/soak.mjs",
    "cap:sync": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.3",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "globals": "16.1.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
